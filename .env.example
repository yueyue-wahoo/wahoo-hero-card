# OpenAI
OPENAI_API_KEY=sk-...

# Wahoo Cloud — demo booth account credentials
WAHOO_DEMO_EMAIL=
WAHOO_DEMO_PASSWORD=

# Booth login gate
BOOTH_PASSWORD=

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Where the captured-emails CSV is written.
# Local dev: leave blank — defaults to ./data/emails.csv.
# Railway:   attach a volume (e.g. mounted at /data) and set this to
#            EMAIL_CAPTURE_CSV_PATH=/data/emails.csv so submissions survive
#            redeploys.
EMAIL_CAPTURE_CSV_PATH=
